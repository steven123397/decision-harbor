# 复制为 .env 并按工作区调整。所有资源随 COMPOSE_PROJECT_NAME 形成独立命名空间。
COMPOSE_PROJECT_NAME=decisionharbor-main

# 宿主端口（多工作区并行时错开）
WEB_PORT=5173
API_PORT=8000

# 数据库口令（仅本地开发默认值）
POSTGRES_SUPER_PASSWORD=local-super-dev
PLATFORM_APP_PASSWORD=local-platform-dev
ANALYTICS_OWNER_PASSWORD=local-owner-dev
ANALYTICS_READER_PASSWORD=local-reader-dev

# 依赖源（可选）：网络直连官方源慢时启用国内镜像
#PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
#NPM_CONFIG_REGISTRY=https://registry.npmmirror.com

# 查询治理参数（见 docs/design/query-governance.md）
QUERY_TIMEOUT_MS=5000
QUERY_ROW_LIMIT=1000
QUERY_MAX_SQL_LENGTH=100000

# 数据库连接上界：数据库不可达时 /ready 必须有限时间内失败（见 docs/design/local-runtime.md）
DB_CONNECT_TIMEOUT_S=5
DB_STATEMENT_TIMEOUT_MS=5000
