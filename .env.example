# Compose 并行隔离配置（多工作区可覆盖）
DH_PROJECT_NAME=decisionharbor
DH_WEB_PORT=5173
DH_API_PORT=8000

# PostgreSQL 引导身份（仅用于迁移与 seed，不执行用户 SQL）
DH_BOOTSTRAP_USER=postgres
DH_BOOTSTRAP_PASSWORD=decisionharbor

# 逻辑数据库
DH_PLATFORM_DB=platform
DH_ANALYTICS_DB=analytics

# 运行期角色（第二道边界）
DH_PLATFORM_WRITER_USER=dh_platform_writer
DH_PLATFORM_WRITER_PASSWORD=dh_platform_writer
DH_ANALYTICS_READER_USER=dh_analytics_reader
DH_ANALYTICS_READER_PASSWORD=dh_analytics_reader

# 资源限制
DH_STATEMENT_TIMEOUT_MS=30000
DH_ROW_LIMIT=1000
