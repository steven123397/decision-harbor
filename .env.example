# Compose 项目名：多工作区并行运行时改为互不相同的值
DH_PROJECT_NAME=decisionharbor
# 宿主端口：多工作区并行运行时改为互不冲突的值
DH_WEB_PORT=5173
DH_API_PORT=8000
# 数据库口令（仅本地开发用途，勿用于真实环境）
POSTGRES_PASSWORD=postgres-dev-password
PLATFORM_APP_PASSWORD=platform-app-dev-password
ANALYTICS_OWNER_PASSWORD=analytics-owner-dev-password
ANALYTICS_READONLY_PASSWORD=analytics-readonly-dev-password
# 执行资源限制（见 docs/design/query-governance.md）
STATEMENT_TIMEOUT_MS=5000
MAX_ROWS=1000
# 可选：构建期 pip 源（网络访问 PyPI 缓慢时设为镜像，如 https://pypi.tuna.tsinghua.edu.cn/simple）
# PIP_INDEX_URL=https://pypi.org/simple
