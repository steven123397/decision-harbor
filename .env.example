# Compose 并行隔离
COMPOSE_PROJECT_NAME=decisionharbor
API_PORT=8000
WEB_PORT=5173
# Web 内嵌的 API 地址（浏览器视角，默认 localhost）
VITE_API_BASE_URL=http://localhost:8000

# PostgreSQL 超级用户（引导期建库建角色用）
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# 逻辑库
PLATFORM_DB=platform
ANALYTICS_DB=analytics

# 身份
DH_ADMIN_USER=dh_admin
DH_ADMIN_PASSWORD=dh_admin
PLATFORM_WRITER_USER=platform_writer
PLATFORM_WRITER_PASSWORD=platform_writer
ANALYTICS_READER_USER=analytics_reader
ANALYTICS_READER_PASSWORD=analytics_reader

# 资源限制
QUERY_TIMEOUT_MS=30000
QUERY_ROW_LIMIT=10000
MAX_SQL_BYTES=65536

# CORS
CORS_ORIGIN=http://localhost:5173
