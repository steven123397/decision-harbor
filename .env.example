# Compose project name — change per worktree for parallel stacks
COMPOSE_PROJECT_NAME=decisionharbor

# Host ports (must not collide across parallel workspaces)
API_HOST_PORT=8000
WEB_HOST_PORT=5173

# Browser-visible API origin (defaults to localhost + API_HOST_PORT)
# VITE_API_BASE_URL=http://localhost:8000

# Optional query limits
STATEMENT_TIMEOUT_MS=5000
MAX_RESULT_ROWS=1000

# CORS for local web
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
