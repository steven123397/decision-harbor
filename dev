#!/usr/bin/env bash
set -euo pipefail

repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
cd "$repo_root"

compose() {
  if [[ -f .env ]]; then
    docker compose --env-file .env "$@"
  else
    docker compose "$@"
  fi
}

case "${1:-}" in
  up)
    compose up -d --build
    ;;
  down)
    compose down
    ;;
  destroy)
    compose down --volumes --remove-orphans
    ;;
  logs)
    compose logs -f "${2:-}"
    ;;
  test)
    python3 datasets/sales-analytics-v1/validate.py
    compose up -d --build postgres migrate api web
    compose run --rm --no-deps api pytest
    (cd apps/web && npm test && npm run test:browser)
    ;;
  *)
    printf 'usage: %s {up|down|destroy|logs [service]|test}\n' "$0" >&2
    exit 2
    ;;
esac
